<section class="page-section">
    <h2>Edit Topic</h2>

    <form action="/topics/<%= topic._id %>?_method=PUT" method="POST" class="form-card">
        <div class="form-group">
            <label for="title">Title</label>
            <input
                type="text"
                id="title"
                name="title"
                value="<%= topic.title %>"
                required
            >
        </div>

        <div class="form-group">
            <label for="content">Content</label>
            <textarea
                id="content"
                name="content"
                rows="6"
                required
            ><%= topic.content %></textarea>
        </div>

        <button type="submit">Update Topic</button>
    </form>
</section>