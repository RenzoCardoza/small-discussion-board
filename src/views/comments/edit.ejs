<section class="page-section">
    <h2>Edit Comment</h2>

    <form action="/comments/<%= comment._id %>?_method=PUT" method="POST" class="form-card">
        <div class="form-group">
            <label for="content">Comment</label>
            <textarea
                id="content"
                name="content"
                rows="5"
                required
            ><%= comment.content %></textarea>
        </div>

        <button type="submit">Update Comment</button>
    </form>
</section>